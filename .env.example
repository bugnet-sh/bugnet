# Secrets only, every other setting lives in config/*.toml. Paste each value after the = sign.

# Bearer token of the Router API, the router's own BUGNET_INTERNAL_TOKEN (bugnet-router .env.keys)
BUGNET_INTERNAL_TOKEN=

# HMAC key for quote ids, base64 of 32 random bytes: openssl rand -base64 32
BUGNET_QUOTE_KEY=

# Dev payments only: the Ed25519 seed the router's order_token_public_key verifies, the same
# BUGNET_ORDER_PRIVATE_KEY bugnet-dev uses (bugnet-router .env.keys)
BUGNET_ORDER_PRIVATE_KEY=

# payments.mode http only: bearer token for the Payments service, issued by its team
BUGNET_PAYMENTS_TOKEN=

# Trace backend, the whole Authorization header value, empty for a local collector
BUGNET_OTLP_AUTHORIZATION=

# Optional, raises GitHub API limits for bugnet_assess from 60 to 5,000 requests an hour.
# A fine-grained token with no permissions at https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=

# Optional, lets bugnet_assess read gated Hugging Face model metadata, https://huggingface.co/settings/tokens
HF_TOKEN=
