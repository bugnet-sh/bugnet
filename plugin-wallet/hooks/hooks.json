{
    "description": "Bugnet: note when a request or command fits a cloud sandbox, computed locally",
    "hooks": {
        "UserPromptSubmit": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "sh",
                        "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/run.sh", "prompt"],
                        "timeout": 5
                    }
                ]
            }
        ],
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "sh",
                        "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/run.sh", "command"],
                        "timeout": 5
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Bash|mcp__plugin_bugnet-wallet_sandbox__.*|mcp__bugnet__.*",
                "hooks": [
                    {
                        "type": "command",
                        "command": "sh",
                        "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/run.sh", "track"],
                        "timeout": 5
                    }
                ]
            }
        ],
        "PostToolUseFailure": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "sh",
                        "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/run.sh", "failure"],
                        "timeout": 5
                    }
                ]
            }
        ]
    }
}
