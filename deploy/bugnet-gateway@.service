# The gateway as data-plane 15.3 runs services, one versioned directory per instance
[Unit]
Description=Bugnet MCP gateway %i
After=network-online.target
Wants=network-online.target

[Service]
User=bugnet-gateway
Group=bugnet-gateway
WorkingDirectory=/opt/bugnet/gateway/%i
ExecStart=/usr/bin/node /opt/bugnet/gateway/%i/packages/gateway/dist/main.js -config /etc/bugnet/gateway.toml
ExecReload=/bin/kill -HUP $MAINPID
EnvironmentFile=/etc/bugnet/gateway.env
StateDirectory=bugnet-gateway
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
# No MemoryDenyWriteExecute, which Node's JIT cannot run under
LimitNOFILE=65536
LimitCORE=0
TimeoutStopSec=60
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
