{
    "manifest_version": "0.3",
    "name": "bugnet",
    "display_name": "Bugnet",
    "version": "0.1.2",
    "description": "Run untrusted or heavy software in disposable cloud Linux sandboxes, paid per run in USDC on Solana",
    "author": { "name": "Bugnet" },
    "server": {
        "type": "node",
        "entry_point": "server/main.js",
        "mcp_config": { "command": "node", "args": ["${__dirname}/server/main.js"] }
    },
    "compatibility": {
        "platforms": ["darwin", "win32", "linux"],
        "runtimes": { "node": ">=20.19.3" }
    }
}
