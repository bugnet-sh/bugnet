{
    "name": "@bugnet/mcp",
    "version": "0.1.1",
    "license": "Apache-2.0",
    "description": "Local Bugnet bridge: the remote Bugnet MCP gateway over stdio, plus secrets from this machine",
    "type": "module",
    "bin": {
        "bugnet-mcp": "dist/main.js"
    },
    "files": [
        "dist/main.js",
        "config/example.toml",
        "LICENSE"
    ],
    "engines": {
        "node": ">=20.19.3"
    },
    "scripts": {
        "typecheck": "tsc -p .",
        "build": "tsx src/build-main.ts",
        "mcpb": "tsx src/build-mcpb.ts",
        "prepack": "pnpm run build"
    },
    "devDependencies": {
        "@anthropic-ai/mcpb": "2.1.2",
        "@bufbuild/protobuf": "2.16.0",
        "@bugnet/gateway": "workspace:*",
        "@bugnet/seal": "workspace:*",
        "@connectrpc/connect": "2.3.0",
        "@modelcontextprotocol/client": "2.4.0",
        "@modelcontextprotocol/server": "2.4.0",
        "@solana-program/compute-budget": "0.20.0",
        "@solana-program/token": "0.18.0",
        "@solana/kit": "8.6.0",
        "libsodium-wrappers": "0.8.4",
        "smol-toml": "1.9.1",
        "zod": "4.6.7"
    }
}
