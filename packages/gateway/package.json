{
    "name": "@bugnet/gateway",
    "version": "0.1.0",
    "license": "Apache-2.0",
    "private": true,
    "type": "module",
    "exports": {
        ".": "./src/index.ts",
        "./gen": "./src/gen/bugnet/router/v1/router_pb.ts",
        "./server": "./src/server.ts",
        "./testing": "./src/testing/harness.ts"
    },
    "scripts": {
        "proto": "buf generate --template buf.gen.yaml",
        "typecheck": "pnpm proto && tsc -p .",
        "dev": "pnpm proto && tsx src/main.ts -config ../../config/dev.toml",
        "build": "pnpm proto && esbuild src/main.ts --bundle --platform=node --format=esm --target=node26 --packages=external --outfile=dist/main.js && esbuild scripts/x402-crawl.ts --bundle --platform=node --format=esm --target=node26 --packages=external --outfile=dist/x402-crawl.js"
    },
    "dependencies": {
        "@bufbuild/protobuf": "2.16.0",
        "@bugnet/intent": "workspace:*",
        "@connectrpc/connect": "2.3.0",
        "@connectrpc/connect-node": "2.3.0",
        "@modelcontextprotocol/node": "2.1.2",
        "@modelcontextprotocol/server": "2.4.0",
        "@opentelemetry/api": "1.10.0",
        "@opentelemetry/core": "3.0.0",
        "@opentelemetry/otlp-exporter-base": "0.300.0",
        "@opentelemetry/otlp-transformer": "0.300.0",
        "@opentelemetry/resources": "3.0.0",
        "@opentelemetry/sdk-trace": "3.0.0",
        "acme-client": "5.4.0",
        "smol-toml": "1.9.1",
        "undici": "8.12.4",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@bufbuild/protoc-gen-es": "2.16.0",
        "@modelcontextprotocol/client": "2.4.0",
        "@peculiar/x509": "1.14.3"
    }
}
